{
  "name": "daybook",
  "productName": "Daybook",
  "version": "0.1.0",
  "private": true,
  "description": "Tasks, calendar, habits and focus, stored on your Mac",
  "main": "out/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning test/unit.test.ts",
    "package": "node build.mjs --prod && node package.mjs",
    "install-app": "npm run package && node install.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.5.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2"
  }
}